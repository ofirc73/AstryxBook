<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 12 and higher (see backup_rules.xml for 11 and lower).
   Only the app's settings (DataStore) are backed up or moved to a new device.
   The WebView's data (app_webview/: cookies, i.e. the Facebook login session,
   plus storage and cache) is left out on purpose, so the session never leaves
   the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/materialbook_prefs.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/materialbook_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
