<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 11 and lower (see data_extraction_rules.xml for 12+).
   Only the app's settings (DataStore) are backed up. The WebView's data
   (app_webview/: cookies, i.e. the Facebook login session, plus storage and
   cache) is left out on purpose, so the session never leaves the device.
-->
<full-backup-content>
    <include domain="file" path="datastore/materialbook_prefs.preferences_pb" />
</full-backup-content>
